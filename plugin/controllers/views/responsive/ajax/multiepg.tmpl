jQuery(".plusclick").click(function() {
	var day = jQuery(this).data("day");
	var epgmode = "$epgmode";
	if (day != undefined) {
		if (day > 999)
		{
			var w = day - 1000;
			jQuery("#tvcontent").html(loadspinner).load('ajax/multiepg?bref=${quote($bref)}&day='+$day+'&epgmode='+epgmode+'&week='+w);
		}
		else if (day > 199)
		{
			var d = day - 200;
			var dt = (d==0) ? '' : jQuery(this).html();
			var pos = 0;
			if (d == 0 || d == '') {
				var l = jQuery(".timetable-now").css('left');
				pos = parseInt(l.replace('px','')) || 0;
			} else if (d == 1) {
				pos = 140 + (6 * 3600 / 6);
			} else if (d == 2) {
				pos = 140 + (12 * 3600 / 6);
			} else if (d == 3) {
				pos = 140 + (20 * 3600 / 6);
			}

			if (pos > 0) {
				pos -= 160;
				jQuery('#fulltbl').animate({scrollLeft: Math.max(0, pos)}, 500);
			}
		}
		else if (day > 100)
		{
			var mode = day - 100;
			if (mode != $mode) {
				jQuery.ajax({
				url: 'api/setwebconfig?mepgmode=' + mode,
					success: function(data) {
						jQuery("#tvcontent").html(loadspinner).load('ajax/multiepg?bref=${quote($bref)}&day=$day&epgmode='+epgmode+'&week='+$week);
					}
				});
			}
		}
		else {
			jQuery("#tvcontent").html(loadspinner).load('ajax/multiepg?bref=${quote($bref)}&day='+day+'&epgmode='+epgmode+'&week='+$week);
		}
	} else {
		let epgmode = jQuery(this).data("tvradio");
		if (epgmode != undefined) {
			jQuery("#tvcontent").html(loadspinner).load('ajax/multiepg?day='+day+'&epgmode='+epgmode);
		}
	}
});

	if (jQuery("#header").is(':hidden')) { 
		jQuery('#compressmepg').show();
		jQuery('#refreshmepg2').show();
	}
	if (mepgdirect == 1) {
		mepgdirect=0;
		jQuery("#expandmepg").click();
	}

var epgJumpNow = $epg_jump_now;
var epgJumpActiveService = $epg_jump_active_service;
var currentServiceRef = "$current_service_ref";

function autoJumpTvGuide() {
	if (epgJumpActiveService && currentServiceRef) {
		var normActive = currentServiceRef.trim().toLowerCase().replace(/%3a/g, ':');
		var targetCol = null;
		jQuery('#tbl2body td.serviceheader, .serviceheader').each(function() {
			var sref = (jQuery(this).data('sref') || jQuery(this).data('ref') || jQuery(this).attr('data-sref') || jQuery(this).attr('data-ref') || '').toString().trim().toLowerCase().replace(/%3a/g, ':');
			if (sref && (sref === normActive || normActive.indexOf(sref) === 0 || sref.indexOf(normActive) === 0)) {
				targetCol = jQuery(this);
				return false;
			}
		});
		if (targetCol && targetCol.length) {
			var scroller = jQuery('#fulltbl');
			var colPos = targetCol.position();
			if (colPos) {
				var targetX = scroller.scrollLeft() + colPos.left - (scroller.width() / 2) + (targetCol.outerWidth() / 2);
				scroller.scrollLeft(Math.max(0, targetX));
			}
		}
	}
	#if $day == 0
	if (epgJumpNow) {
		var container = jQuery('#fulltbl');
		if (container.length) {
			var containerTop = container.offset().top;
			var containerScroll = container.scrollTop();
			var headerHeight = jQuery('.serviceheader').first().outerHeight() || 0;
			var currentHour = (new Date()).getHours();
			var slotIndex = Math.floor(currentHour / 2);
			var targetSlotIndex = slotIndex;

			var nowTs = Math.floor(Date.now() / 1000);
			var minSlot = Math.max(0, slotIndex - 1);
			for (var s = minSlot; s <= slotIndex; s++) {
				var sRow = jQuery('#tbl1body').find('tr').eq(s);
				var hasRunning = false;
				sRow.find('.event, .epg__event').each(function() {
					var b = parseInt(jQuery(this).attr('data-begin')) || 0;
					var e = parseInt(jQuery(this).attr('data-end')) || 0;
					if (b > 0 && e > 0 && b <= nowTs && nowTs < e) {
						hasRunning = true;
						return false;
					}
				});
				if (hasRunning) {
					targetSlotIndex = s;
					break;
				}
			}

			var targetRow = jQuery('#tbl1body').find('tr').eq(targetSlotIndex);
			if (targetRow.length) {
				var targetY = targetRow.offset().top - containerTop + containerScroll - headerHeight;
				container.scrollTop(Math.max(0, targetY));
			}
		}
	}
	#end if
}

function autoJumpTimeline() {
	var targetRow = null;
	if (epgJumpActiveService && currentServiceRef) {
		var normActive = currentServiceRef.trim().toLowerCase().replace(/%3a/g, ':');
		jQuery('.epg__row').each(function() {
			var sref = (jQuery(this).data('sref') || jQuery(this).data('ref') || jQuery(this).attr('data-sref') || jQuery(this).attr('data-ref') || '').toString().trim().toLowerCase().replace(/%3a/g, ':');
			if (sref && (sref === normActive || normActive.indexOf(sref) === 0 || sref.indexOf(normActive) === 0)) {
				targetRow = jQuery(this);
				return false;
			}
		});
		if (targetRow && targetRow.length) {
			var container = jQuery('#fulltbl');
			var rowPos = targetRow.position();
			if (rowPos) {
				var targetY = container.scrollTop() + rowPos.top - (container.height() / 2) + (targetRow.outerHeight() / 2);
				container.scrollTop(Math.max(0, targetY));
			}
		}
	}
	#if $day == 0
	if (epgJumpNow) {
		var container = jQuery('#fulltbl');
		var targetX = 0;
		var activeRow = targetRow && targetRow.length ? targetRow : jQuery('.epg__row').first();
		var currEvent = activeRow.find('.curevent').first().closest('.event');
		if (!currEvent.length) {
			currEvent = jQuery('.curevent').first().closest('.event');
		}
		if (currEvent.length && currEvent.position()) {
			targetX = currEvent.position().left;
		} else {
			var l = jQuery(".timetable-now").css('left');
			if (l) {
				targetX = parseInt(l.replace('px', '')) || 0;
			}
		}
		if (targetX > 0) {
			container.scrollLeft(Math.max(0, targetX - 160));
		}
	}
	#end if
}

setTimeout(function() {
	#if $mode == 1
	autoJumpTvGuide();
	#else
	autoJumpTimeline();
	#end if
}, 100);
</script>
